rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCVAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/cv_admins/$(request.auth.uid)) ||
        request.auth.token.email == 'timdev369@gmail.com'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isCVAdmin());
    }

    // Lembaga collection
    match /lembaga/{lembagaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Buku collection (Master Data CV)
    match /buku/{bukuId} {
      allow read: if isSignedIn();
      allow write: if isCVAdmin();
    }

    // Pengajuan collection
    match /pengajuan/{pengajuanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isCVAdmin();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Settings collection (Super Admin CV)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isCVAdmin();
    }
  }
}
